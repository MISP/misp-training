% Shared MISP visual identity 2.0 for Beamer templates.
% SPDX-License-Identifier: GPL-3.0-or-later
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mispidentity}[2026/10/29 Shared MISP visual identity 2.0]
\RequirePackage{tikz}
\RequirePackage[export]{adjustbox}
\mode<presentation>


% Exact RGB values from the official 2.0 screen logo.
\definecolor{mispNavy}{HTML}{02394A}
\definecolor{mispTeal}{HTML}{00708D}
\definecolor{mispBlue}{HTML}{0091B0}
\definecolor{mispCyan}{HTML}{19C9F0}
\definecolor{mispInk}{HTML}{28191B}
\colorlet{main}{mispNavy}
\colorlet{textcolor}{mispInk}
\colorlet{background}{white}

\setbeamercolor{normal text}{fg=mispInk,bg=white}
\setbeamercolor{structure}{fg=mispTeal}
\setbeamercolor{titlelike}{fg=white,bg=mispNavy}
\setbeamercolor{frametitle}{fg=white,bg=mispNavy}
\setbeamercolor{footline}{fg=white,bg=mispNavy}
\setbeamercolor{author in head/foot}{fg=white,bg=mispNavy}
\setbeamercolor{block title}{fg=white,bg=mispTeal}
\setbeamercolor{block body}{fg=mispInk,bg=mispBlue!7!white}
\setbeamercolor{itemize item}{fg=mispTeal}
\setbeamercolor{itemize subitem}{fg=mispBlue}
\setbeamercolor{enumerate item}{fg=mispTeal}
\setbeamercolor{enumerate subitem}{fg=mispTeal}
\hypersetup{colorlinks=true,urlcolor=mispTeal,linkcolor=mispTeal}

% Keep the portable Fira body fonts, with bold mixed-case headings.
% The official wordmark contains its original outlined typography.
\setbeamerfont{title}{size=\Large,series=\bfseries,shape=\upshape}
\setbeamerfont{subtitle}{size=\normalsize,series=\mdseries,shape=\upshape}
\setbeamerfont{frametitle}{size=\large,series=\bfseries,shape=\upshape}
\setbeamerfont{sectiontitle}{size=\Large,series=\bfseries,shape=\upshape}
\setbeamerfont{focusframe}{size=\Large,series=\bfseries,shape=\upshape}

\newcommand{\misppartnergraphic}[1]{\def\misp@partnergraphic{#1}}
\misppartnergraphic{}

% Override with \titlegraphic if a deck needs another official lockup.
\titlegraphic{\includegraphics[width=.42\paperwidth]{misp-logo.pdf}}

\setbeamertemplate{title page}{%
    \begin{tikzpicture}[remember picture,overlay]
        \fill[white] (current page.south west) rectangle (current page.north east);
        \fill[mispNavy] ([yshift=-.36\paperheight]current page.north west)
            rectangle (current page.south east);
        \fill[mispCyan] ([yshift=-.36\paperheight]current page.north west)
            rectangle ([yshift=-.36\paperheight-2pt]current page.north east);
        \node[anchor=north west,inner sep=0pt]
            at ([xshift=.75cm,yshift=-.65cm]current page.north west)
            {\inserttitlegraphic};
        \node[anchor=north east,inner sep=0pt]
            at ([xshift=-.75cm,yshift=-.65cm]current page.north east)
            {\misp@partnergraphic};
        \node[anchor=north west,inner sep=0pt,text=white]
            at ([xshift=.75cm,yshift=-.42\paperheight]current page.north west) {%
            \begin{adjustbox}{max totalsize={\dimexpr\paperwidth-1.5cm\relax}{.52\paperheight}}
            \begin{minipage}{\dimexpr\paperwidth-1.5cm\relax}
                \raggedright
                \hypersetup{urlcolor=mispCyan,linkcolor=white}% Contrast on navy.
                {\usebeamerfont{title}\inserttitle\par}
                \medskip
                {\usebeamerfont{subtitle}\color{mispCyan}\insertsubtitle\par}
                \bigskip
                {\usebeamerfont{author}\insertauthor\par}
                \smallskip
                {\usebeamerfont{institute}\insertinstitute\par}
                \smallskip
                {\usebeamerfont{date}\insertdate\par}
            \end{minipage}
            \end{adjustbox}
        };
    \end{tikzpicture}%
    \addtocounter{framenumber}{-1}% Match Focus's unnumbered title page.
}

\setbeamertemplate{section page}{%
    \begin{tikzpicture}[remember picture,overlay]
        \fill[mispNavy] (current page.south west) rectangle (current page.north east);
        \fill[mispCyan] ([yshift=-.22\paperheight]current page.north west)
            rectangle ([yshift=-.22\paperheight-2pt]current page.north east);
        \node[anchor=west,text=white,inner sep=0pt]
            at ([xshift=.75cm]current page.west) {%
            \begin{minipage}{\dimexpr\paperwidth-1.5cm\relax}
                \raggedright
                \usebeamerfont{sectiontitle}% Avoid section hyperlink color on navy.
                \let\hyperlink\@secondoftwo\insertsection
            \end{minipage}
        };
    \end{tikzpicture}%
}

\mode<all>
